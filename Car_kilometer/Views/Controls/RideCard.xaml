<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Car_kilometer.Models"
             x:Class="Car_kilometer.Views.Controls.RideCard"
             x:DataType="models:RideItem">

    <Border Style="{StaticResource Card}" Padding="14">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
            <Border Style="{StaticResource IconBadge}" VerticalOptions="Center">
                <Label Text="{Binding WeatherGlyph}" Style="{StaticResource Glyph}" />
            </Border>

            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                <Label Text="{Binding DisplayDescription}"
                       FontFamily="ManropeSemiBold"
                       FontSize="15"
                       MaxLines="1"
                       LineBreakMode="TailTruncation" />
                <Label Text="{Binding DetailsText}"
                       Style="{StaticResource Muted}"
                       FontSize="12.5"
                       MaxLines="1"
                       LineBreakMode="TailTruncation" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Column="2" Spacing="3" VerticalOptions="Center">
                <Label Text="{Binding DistanceText}"
                       FontFamily="ManropeExtraBold"
                       FontSize="16"
                       HorizontalOptions="End" />
                <Label Text="{Binding SpeedText}"
                       Style="{StaticResource Muted}"
                       FontSize="12"
                       HorizontalOptions="End" />
            </VerticalStackLayout>
        </Grid>
    </Border>

</ContentView>
