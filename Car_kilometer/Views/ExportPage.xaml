<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:vm="clr-namespace:Car_kilometer.ViewModels"
             xmlns:strings="clr-namespace:Car_kilometer.Resources.Strings"
             xmlns:icons="clr-namespace:Car_kilometer.Resources"
             x:Class="Car_kilometer.Views.ExportPage"
             x:DataType="vm:ExportViewModel"
             Shell.PresentationMode="ModalAnimated"
             ios:Page.ModalPresentationStyle="PageSheet">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Padding="20,20,16,8" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label Text="{x:Static strings:AppResources.ExportTitle}" Style="{StaticResource Heading}" VerticalOptions="Center" />
            <Button Grid.Column="1"
                    Text="{x:Static icons:Icons.Close}"
                    Style="{StaticResource IconButton}"
                    Command="{Binding CloseCommand}"
                    SemanticProperties.Description="{x:Static strings:AppResources.Close}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,8,20,16" Spacing="22">

                <!-- Period -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="{x:Static strings:AppResources.Period}" Style="{StaticResource FieldLabel}" />
                    <FlexLayout BindableLayout.ItemsSource="{Binding Periods}" Wrap="Wrap">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PeriodOption">
                                <Border Style="{StaticResource Chip}" Padding="14,9" Margin="0,0,8,8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPeriodTapped" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding Label}" FontFamily="ManropeSemiBold" FontSize="14">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource White}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding IsCustom}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{x:Static strings:AppResources.From}" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputField}">
                                <DatePicker Date="{Binding CustomFrom}" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="{x:Static strings:AppResources.To}" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputField}">
                                <DatePicker Date="{Binding CustomTo}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <!-- What the report contains -->
                <Border Style="{StaticResource Card}" Padding="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Style="{StaticResource IconBadge}" VerticalOptions="Center">
                            <Label Text="{x:Static icons:Icons.Pdf}" Style="{StaticResource Glyph}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding PreviewTitle}" FontFamily="ManropeExtraBold" FontSize="16" />
                            <Label Text="{Binding PreviewPeriod}" Style="{StaticResource Muted}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Driver -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static strings:AppResources.Driver}" Style="{StaticResource FieldLabel}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border Style="{StaticResource InputField}">
                            <Entry Text="{Binding FirstName}"
                                   Placeholder="{x:Static strings:AppResources.FirstName}"
                                   Keyboard="Text"
                                   IsTextPredictionEnabled="False"
                                   ReturnType="Next" />
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource InputField}">
                            <Entry Text="{Binding LastName}"
                                   Placeholder="{x:Static strings:AppResources.LastName}"
                                   Keyboard="Text"
                                   IsTextPredictionEnabled="False"
                                   ReturnType="Next" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- Recipient -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static strings:AppResources.Recipient}" Style="{StaticResource FieldLabel}" />
                    <Border Style="{StaticResource InputField}">
                        <Entry Text="{Binding RecipientEmail}"
                               Placeholder="{x:Static strings:AppResources.EmailPlaceholder}"
                               Keyboard="Email"
                               IsSpellCheckEnabled="False"
                               IsTextPredictionEnabled="False"
                               ReturnType="Done" />
                    </Border>
                </VerticalStackLayout>

                <Label Text="{Binding Error}" Style="{StaticResource ErrorText}" IsVisible="{Binding HasError}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Actions -->
        <VerticalStackLayout Grid.Row="2" Padding="20,8,20,12" Spacing="10">
            <Button Text="{x:Static strings:AppResources.SendByEmail}" Command="{Binding SendEmailCommand}" ContentLayout="Left,8">
                <Button.ImageSource>
                    <FontImageSource FontFamily="Icons" Glyph="{x:Static icons:Icons.Mail}" Color="{StaticResource White}" Size="20" />
                </Button.ImageSource>
            </Button>
            <Button Text="{x:Static strings:AppResources.SharePdf}" Style="{StaticResource SecondaryButton}" Command="{Binding SharePdfCommand}" ContentLayout="Left,8">
                <Button.ImageSource>
                    <FontImageSource FontFamily="Icons"
                                     Glyph="{x:Static icons:Icons.Share}"
                                     Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryOnDark}}"
                                     Size="20" />
                </Button.ImageSource>
            </Button>
        </VerticalStackLayout>

        <!-- While the PDF is created -->
        <Grid Grid.RowSpan="3" IsVisible="{Binding IsBusy}" BackgroundColor="#66000000">
            <Border Style="{StaticResource Card}" HorizontalOptions="Center" VerticalOptions="Center" Padding="28,22">
                <VerticalStackLayout Spacing="12">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" />
                    <Label Text="{x:Static strings:AppResources.CreatingPdf}" FontFamily="ManropeSemiBold" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
