<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Car_kilometer</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>

		<!-- Display name -->
		<ApplicationTitle>Car Kilometer</ApplicationTitle>

		<!-- App Identifier. Never change it: the rides already stored on the phone belong to this identifier. -->
		<ApplicationId>com.companyname.car_kilometer</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>2.0</ApplicationDisplayVersion>
		<ApplicationVersion>2</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>

		<!-- Only ship the languages the app is translated into -->
		<SatelliteResourceLanguages>en;fr</SatelliteResourceLanguages>

		<!-- Also compile the bindings that set a Source, so every binding is checked at build time -->
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#4F46E5" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#4F46E5" BaseSize="168,168" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*.ttf" />

		<!-- The PDF report embeds the app font -->
		<EmbeddedResource Include="Resources\Fonts\Manrope-Regular.ttf" LogicalName="Pdf.Manrope-Regular.ttf" />
		<EmbeddedResource Include="Resources\Fonts\Manrope-ExtraBold.ttf" LogicalName="Pdf.Manrope-ExtraBold.ttf" />

		<!-- Strings (English by default, French in AppResources.fr.resx). The AppResources class is generated at build time. -->
		<EmbeddedResource Update="Resources\Strings\AppResources.resx">
			<StronglyTypedFileName>$(IntermediateOutputPath)AppResources.Designer.cs</StronglyTypedFileName>
			<StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
			<StronglyTypedNamespace>Car_kilometer.Resources.Strings</StronglyTypedNamespace>
			<StronglyTypedClassName>AppResources</StronglyTypedClassName>
			<PublicClass>true</PublicClass>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<!-- Pinned: Shiny.Hosting.Maui needs MAUI 10.0.100 or later, and all the MAUI packages must have the same version -->
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.7" />
		<PackageReference Include="Realm" Version="20.1.0" />
		<PackageReference Include="Shiny.Hosting.Maui" Version="5.7.2" />
		<PackageReference Include="Shiny.Locations" Version="5.7.2" />
		<!-- Stays on 26.x: the Syncfusion license key registered in App.xaml.cs is only valid for this version -->
		<PackageReference Include="Syncfusion.Pdf.NET" Version="26.2.11" />
	</ItemGroup>

</Project>
